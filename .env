OLLAMA_BASE_URL=http://localhost:11434
AGENT_MODEL=auto
AGENT_VISION_MODEL=qwen3-vl:8b
AGENT_TEXT_MODEL=qwen3:8b
AGENT_FALLBACK_MODEL=llama3.2:latest
AGENT_VISION_FALLBACK_MODEL=llama3.2-vision:latest

# Timeouts are milliseconds; 0 removes the limit entirely (the call waits as
# long as the model needs). Vision/video calls get their own larger budget.
AGENT_MODEL_TIMEOUT_MS=300000
OLLAMA_TIMEOUT_MS=300000
OLLAMA_VISION_TIMEOUT_MS=600000
AGENT_TOTAL_TIMEOUT_MS=900000
AGENT_SYSTEM_PROMPT_FILE=agent-system-prompt.md
AGENT_MAX_TOOL_STEPS=8
ROO_AGENT_ENABLED=true
ROO_AGENT_MODE=autonomous
ROO_AGENT_MAX_STEPS=8
ROO_AGENT_VERIFY=true
ROO_AGENT_PREVIEW=true

# Local media pipeline
AGENT_VISION_FRAME_COUNT=6
AGENT_VISION_MAX_IMAGE_WIDTH=1280
# Sample interval (seconds) when ffprobe cannot report the clip duration.
AGENT_VISION_FRAME_INTERVAL=3
# Budget for one sequential FFmpeg frame-extraction pass (0 = no limit).
AGENT_FFMPEG_TIMEOUT_MS=90000
AGENT_FFPROBE_TIMEOUT_MS=15000
