[TEMPLATE]
# Agent21 — fully local/offline AI configuration
# Ollama must be running locally on this machine.
OLLAMA_BASE_URL=http://localhost:11434

# Auto routing: qwen3:8b for coding/text, qwen3-vl:8b for images/video.
AGENT_MODEL=auto
AGENT_VISION_MODEL=qwen3-vl:8b
AGENT_TEXT_MODEL=qwen3:8b
AGENT_FALLBACK_MODEL=llama3.2:latest
AGENT_VISION_FALLBACK_MODEL=llama3.2-vision:latest

# Time/context tuned for a 16 GB RAM / 8-core Windows PC.
# Timeouts are milliseconds; 0 removes the limit entirely (the call waits as
# long as the model needs). Vision/video calls get their own larger budget.
AGENT_MODEL_TIMEOUT_MS=300000
OLLAMA_TIMEOUT_MS=300000
OLLAMA_VISION_TIMEOUT_MS=600000
AGENT_TOTAL_TIMEOUT_MS=900000
AGENT_MAX_TOOL_STEPS=8

# Media pipeline: frame sampling for videos (metadata fallback if FFmpeg fails).
AGENT_VISION_FRAME_COUNT=6
AGENT_VISION_MAX_IMAGE_WIDTH=1280
AGENT_VISION_FRAME_INTERVAL=3
AGENT_FFMPEG_TIMEOUT_MS=90000

# Permanent autonomous agent system prompt. Keep this file inside the active workspace.
AGENT_SYSTEM_PROMPT_FILE=agent-system-prompt.md

# Roo-style local agent behavior is built into Agent21; no VS Code extension is required.
ROO_AGENT_ENABLED=true
ROO_AGENT_MODE=autonomous
ROO_AGENT_MAX_STEPS=8
ROO_AGENT_VERIFY=true
ROO_AGENT_PREVIEW=true
# Optional: explicit FFmpeg paths when Agent21 is launched from a shortcut or stale PATH.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
# FFmpeg is resolved from these values, PATH, and (as a safety net for stale
# shells) common install locations: WinGet, Scoop, chocolatey, Program Files.
# Set AGENT_FFMPEG_DISCOVERY=off to resolve from FFMPEG_PATH/FFPROBE_PATH and
# PATH only — useful to pin a specific install or to test a machine without FFmpeg.
# AGENT_FFMPEG_DISCOVERY=on
AGENT_FFPROBE_TIMEOUT_MS=15000

# File Safety & Sandbox Rule: NEW agent file writes targeting src/ or the
# project root are redirected into <workspace>/.sandbox/ (git-ignored) unless
# the write_file tool passes allow_project=true (user explicitly asked to
# create that file in the main project). Existing files stay editable.
# Set AGENT_SANDBOX_ENFORCE=off to disable the redirect entirely.
# AGENT_SANDBOX_ENFORCE=on
